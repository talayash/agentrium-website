---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Agents from '../components/Agents.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';

// Fetch the latest version from GitHub Releases at build time.
let version = '1.32.0'; // fallback; kept close to the current published release
try {
  const res = await fetch('https://api.github.com/repos/talayash/agentrium/releases/latest', {
    headers: { Accept: 'application/vnd.github.v3+json' },
  });
  if (res.ok) {
    const data = await res.json();
    version = data.tag_name?.replace(/^v/, '') || version;
  } else {
    console.warn(`GitHub releases API returned ${res.status}, using fallback version ${version}`);
  }
} catch (e) {
  console.warn(`Failed to fetch GitHub release: ${e}, using fallback version ${version}`);
}

// Workaround for a Node 24 + Windows teardown race, not a functional step.
// If the build finishes too soon after this fetch resolves, Node aborts in
// libuv teardown (assertion in win/async.c) and `npm run build` exits 127
// even though the build succeeded. The old repo URL masked this by spending
// an extra round trip on a 301 redirect. Linux (CI and Vercel) is unaffected.
await new Promise((resolve) => setTimeout(resolve, 500));
---

<Layout title="Agentrium - every agent, one window">
  <Navbar version={version} />
  <Hero version={version} />
  <Agents />
  <Features />
  <Screenshots />
  <Download version={version} />
  <Footer version={version} />
</Layout>
