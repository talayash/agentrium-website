---
interface Props {
  version?: string;
}
const { version } = Astro.props;
---

<header class="nav-wrap">
  <nav class="nav glass-night" aria-label="Main">
    <a class="nav-brand" href="/">
      <img src="/icons/mark.png" alt="" width="22" height="22" class="nav-mark" decoding="async" />
      <span class="nav-name">Agentrium</span>
      {version && <span class="nav-version">v{version}</span>}
    </a>

    <button class="nav-burger" id="nav-burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span>
    </button>

    <div class="nav-links" id="nav-links">
      <a href="/#agents">Agents</a>
      <a href="/#features">Features</a>
      <a href="/#screenshots">Screenshots</a>
      <a href="/changelog">Changelog</a>
      <a href="https://github.com/talayash/agentrium" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/#download" class="nav-cta tint">Download</a>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding: 0 16px;
    pointer-events: none;
  }

  .nav {
    pointer-events: auto;
    --lg-blur: 28px;
    /* Dark-tinted glass: the nav floats over both the Midnight hero and the
       light sections, so its fill must keep light text readable on either. */
    background: rgba(14, 17, 30, 0.82);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    max-width: 880px;
    padding: 9px 10px 9px 18px;
    border-radius: 999px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--night-text);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .nav-version {
    font-size: 11px;
    font-weight: 500;
    color: var(--night-text-3);
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--night-seam-strong);
    font-variant-numeric: tabular-nums;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav-links a {
    color: var(--night-text-2);
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    padding: 7px 12px;
    border-radius: 999px;
    transition: color 160ms ease-out, background 160ms ease-out;
  }
  .nav-links a:hover {
    color: var(--night-text);
    background: rgba(255, 255, 255, 0.08);
  }
  /* Scroll-spy: the link for the section in view wears the glass lens. */
  .nav-links a.lens,
  .nav-links a.lens:hover { color: var(--night-text); background: rgba(255, 255, 255, 0.17); }
  .nav-links a.nav-cta {
    color: #fff;
    font-weight: 600;
    padding: 7px 16px;
    margin-left: 4px;
  }
  .nav-links a.nav-cta:hover { background: color-mix(in srgb, var(--accent) 88%, #fff); }

  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    padding: 10px;
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--night-text);
    transition: transform 200ms ease-out, opacity 200ms ease-out;
  }
  .nav-burger[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .nav-burger[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  @media (max-width: 767px) {
    .nav { border-radius: 22px; flex-wrap: wrap; }
    .nav-burger { display: flex; }
    .nav-links {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      padding: 8px 4px 10px;
    }
    .nav-links.open { display: flex; }
    .nav-links a { padding: 11px 14px; border-radius: 12px; font-size: 15px; }
    .nav-links a.nav-cta { margin-left: 0; text-align: center; }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger');
  const links = document.getElementById('nav-links');
  burger?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  // Collapse the mobile menu after navigating to an anchor.
  links?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      links.classList.remove('open');
      burger?.setAttribute('aria-expanded', 'false');
    })
  );

  // Scroll-spy: mark the link whose section is in view with the lens
  // material. Only on the homepage, where the anchors exist.
  const spyLinks = Array.from(links?.querySelectorAll<HTMLAnchorElement>('a[href^="/#"]') ?? [])
    .filter((a) => !a.classList.contains('nav-cta'));
  // #download is observed too: the Download CTA already stands for it, so
  // reaching it clears the lens instead of leaving the previous link lit.
  const spyTargets = [...spyLinks.map((a) => a.getAttribute('href')!.slice(2)), 'download']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  if (spyTargets.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          spyLinks.forEach((a) => {
            const on = a.getAttribute('href') === `/#${e.target.id}`;
            a.classList.toggle('lens', on);
            if (on) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    spyTargets.forEach((t) => spy.observe(t));
  }
</script>
