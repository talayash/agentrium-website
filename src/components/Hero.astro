---
interface Props {
  version: string;
}
const { version } = Astro.props;

const releaseBase = 'https://github.com/talayash/agentrium/releases/latest/download';
const winInstaller = `${releaseBase}/Agentrium_${version}_x64-setup.exe`;
const macInstaller = `${releaseBase}/Agentrium_${version}_aarch64.dmg`;

// The mock session sidebar: one card per agent, matching the app's new
// single-switcher IA (session cards, not tabs).
const sessions = [
  { name: 'api-refactor', agent: 'Claude Code', dot: '#D97757', status: 'Working', active: true, unread: false },
  { name: 'auth-hotfix', agent: 'Codex', dot: '#19C37D', status: 'Waiting on you', active: false, unread: true },
  { name: 'docs-site', agent: 'Cursor', dot: '#9B9BF7', status: 'Done', active: false, unread: false },
  { name: 'perf-sweep', agent: 'Antigravity', dot: '#4285F4', status: 'Idle', active: false, unread: false },
];
---

<section class="hero night-band">
  <div class="night-glow"></div>

  <div class="container-wide hero-inner">
    <p class="hero-kicker glass-clear reveal">
      <span class="hero-kicker-tag tint">v{version}</span>
      macOS + Windows &middot; free and open source
    </p>

    <h1 class="display hero-h1 reveal" style="--d: 80ms">
      Every agent.<br />One window.
    </h1>

    <p class="subhead hero-sub reveal" style="--d: 160ms">
      Agentrium is the native desktop home for Claude Code, Codex, Cursor,
      and Antigravity. Spawn sessions, mix agents, and watch them work side by side.
    </p>

    <div class="hero-cta reveal" style="--d: 240ms">
      <a
        id="hero-primary-dl"
        class="btn-light-pill"
        href="#download"
        data-win={winInstaller}
        data-mac={macInstaller}
      >
        Download
      </a>
      <a
        class="btn-glass-night"
        href="https://github.com/talayash/agentrium"
        target="_blank"
        rel="noopener noreferrer"
      >
        View on GitHub
      </a>
    </div>

    <!-- Live product mockup: the app's Liquid Glass direction A, floating
         glass chrome over the in-app gradient with opaque terminal panes. -->
    <div class="app-window glass-night reveal" style="--d: 340ms" role="img" aria-label="The Agentrium main window: a floating glass sidebar of session cards, a tab capsule, two terminal panes and a status capsule">
      <aside class="win-sidebar glass-night">
        <div class="win-dots" aria-hidden="true">
          <span style="background:#FF5F57"></span>
          <span style="background:#FEBC2E"></span>
          <span style="background:#28C840"></span>
        </div>
        <div class="win-side-label">Sessions</div>
        {sessions.map((s) => (
          <div class={`win-card${s.active ? ' lens' : ''}`}>
            <span class={`win-agent-dot${s.active ? ' glow' : ''}`} style={`background:${s.dot};color:${s.dot}`} aria-hidden="true"></span>
            <span class="win-card-text">
              <span class="win-card-name">{s.name}</span>
              <span class="win-card-sub">{s.agent} &middot; {s.status}</span>
            </span>
            {s.unread && <span class="win-unread" aria-hidden="true"></span>}
          </div>
        ))}
        <div class="win-new glass-clear">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          New Session
        </div>
      </aside>

      <div class="win-main">
        <div class="win-toolbar">
          <div class="win-tabs glass-night">
            <span class="win-tab lens"><i style="background:#D97757"></i>api-refactor</span>
            <span class="win-tab"><i style="background:#19C37D"></i>auth-hotfix</span>
          </div>
          <span class="win-branch glass-clear">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="6" cy="5" r="2.2"/><circle cx="6" cy="19" r="2.2"/><circle cx="18" cy="7" r="2.2"/><path d="M6 7.2v9.6M18 9.2c0 4-6 3.5-11 7"/></svg>
            feat/session-store
          </span>
          <span class="win-spacer"></span>
          <div class="win-layout glass-night" aria-hidden="true">
            <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="3"/></svg></span>
            <span class="lens"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="8" height="16" rx="2"/><rect x="13" y="4" width="8" height="16" rx="2"/></svg></span>
            <span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg></span>
          </div>
        </div>

        <div class="win-panes">
          <div class="win-pane is-focused">
            <div class="win-pane-head">
              <span class="win-session-name">api-refactor</span>
              <span class="win-model">Claude &middot; opus</span>
            </div>
            <div class="win-term" id="hero-term" data-played="false">
              <div class="term-line"><span class="term-prompt">&gt;</span> <span class="term-typed" id="term-typed"></span><span class="term-caret agr-caret" aria-hidden="true"></span></div>
              <div class="term-out" data-line="1"><span class="term-glyph" style="color:#D97757">&#9679;</span> Reading src/store/terminalStore.ts</div>
              <div class="term-out" data-line="2"><span class="term-glyph" style="color:#D97757">&#9679;</span> Edited terminalStore.ts <span class="term-add">+42</span> <span class="term-del">-17</span></div>
              <div class="term-out" data-line="3"><span class="term-glyph" style="color:#28C840">&#10003;</span> 388 tests passed</div>
              <div class="term-out term-dim" data-line="4">Session cost: $0.14 &middot; 2m 31s</div>
            </div>
          </div>
          <div class="win-pane win-pane-2">
            <div class="win-pane-head">
              <span class="win-session-name">auth-hotfix</span>
              <span class="win-model">Codex</span>
            </div>
            <div class="win-term">
              <div><span class="term-prompt">&gt;</span> <span class="term-typed">fix token refresh race on resume</span></div>
              <div><span class="term-glyph" style="color:#19C37D">&#9679;</span> Patched src-tauri/src/auth.rs</div>
              <div><span class="term-glyph" style="color:#19C37D">&#9679;</span> Proposed 2 hunks for review</div>
              <div class="term-typed">Apply changes? <span class="term-dim">[y/n]</span></div>
            </div>
          </div>
        </div>

        <div class="win-status glass-night">
          <span class="win-status-live"><span class="win-chip-pulse" aria-hidden="true"></span>2 working</span>
          <span>1 waiting on you</span>
          <span class="win-spacer"></span>
          <span class="win-status-mono">$0.31 today</span>
          <span class="win-status-keys">F1 Commands</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-fade" aria-hidden="true"></div>
</section>

<style>
  .hero {
    padding: 168px 0 0;
    text-align: center;
  }
  @media (max-width: 767px) { .hero { padding-top: 128px; } }

  .hero-inner { position: relative; z-index: 1; }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: #D6D8E4;
    margin: 0 0 26px;
    padding: 6px 16px 6px 6px;
    border-radius: var(--radius-pill);
  }
  .hero-kicker-tag {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-variant-numeric: tabular-nums;
  }

  .hero-h1 {
    color: var(--night-text);
    margin: 0 auto 24px;
    background: linear-gradient(180deg, #FFFFFF 30%, #B9C4E8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    color: var(--night-text-2);
    max-width: 56ch;
    margin: 0 auto 36px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 84px;
  }

  /* ---------- The mock app window ---------- */
  /* The frame is glass over the hero glows; its own gradient fill is what
     the floating panels inside refract, just as the app's chrome blurs the
     .app-root gradient rather than the desktop. */
  .app-window {
    --lg-blur: 30px;
    max-width: 1060px;
    margin: 0 auto;
    padding: 12px;
    border-radius: 30px;
    text-align: left;
    display: grid;
    grid-template-columns: 236px 1fr;
    gap: 12px;
    min-height: 460px;
    background:
      radial-gradient(520px 360px at 70% 0%, rgba(59, 92, 230, 0.30), transparent 70%),
      radial-gradient(460px 360px at 10% 100%, rgba(122, 91, 255, 0.24), transparent 72%),
      rgba(20, 24, 44, 0.40);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.26),
      inset 0 -1px 0 rgba(0, 0, 0, 0.30),
      var(--shadow-float-lg);
  }
  @media (max-width: 760px) {
    .app-window { grid-template-columns: 1fr; border-radius: 24px; padding: 10px; }
    .win-sidebar, .win-branch, .win-pane-2 { display: none !important; }
  }
  @media (max-width: 480px) {
    .win-layout, .win-status-keys { display: none !important; }
  }

  .win-sidebar {
    --lg-blur: 20px;
    padding: 14px 10px;
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .win-dots { display: flex; gap: 7px; padding: 2px 8px 14px; }
  .win-dots span { width: 11px; height: 11px; border-radius: 50%; display: block; }

  .win-side-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--night-text-3);
    padding: 0 10px 6px;
  }

  .win-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 16px;
    transition: background 160ms ease-out;
  }
  .win-card:not(.lens):hover { background: rgba(255, 255, 255, 0.05); }

  .win-agent-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .win-agent-dot.glow { box-shadow: 0 0 10px currentColor; }

  .win-card-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .win-card-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--night-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .win-card-sub {
    font-size: 10.5px;
    color: var(--night-text-3);
    white-space: nowrap;
  }
  .win-card.lens .win-card-sub { color: #C7C9D6; }

  .win-unread {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    flex: none;
  }

  .win-new {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 38px;
    font-size: 12px;
    font-weight: 600;
    color: #D6D8E4;
    border-radius: var(--radius-pill);
  }

  .win-main { display: flex; flex-direction: column; gap: 12px; min-width: 0; }

  .win-toolbar { display: flex; align-items: center; gap: 10px; }
  .win-spacer { flex: 1; }

  .win-tabs {
    --lg-blur: 18px;
    display: flex;
    gap: 2px;
    padding: 4px;
    border-radius: var(--radius-pill);
  }
  .win-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 500;
    color: var(--night-text-2);
    white-space: nowrap;
  }
  .win-tab.lens { color: var(--night-text); font-weight: 600; }
  .win-tab i { width: 6px; height: 6px; border-radius: 50%; display: block; }

  .win-branch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #C7C9D6;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .win-layout {
    --lg-blur: 18px;
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-pill);
    color: var(--night-text-2);
  }
  .win-layout span {
    width: 30px; height: 26px;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-pill);
  }
  .win-layout span.lens { color: var(--night-text); }

  .win-panes {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 760px) { .win-panes { grid-template-columns: 1fr; } }

  /* Terminal output always sits on an opaque surface, never glass. */
  .win-pane {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    background: rgba(10, 12, 20, 0.88);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    min-width: 0;
  }
  .win-pane.is-focused {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--accent) 80%, transparent),
      0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent),
      0 0 36px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .win-pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 18px 0;
  }
  .win-session-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--night-text);
  }
  .win-model {
    font-size: 11px;
    color: var(--night-text-3);
  }

  .win-term {
    flex: 1;
    padding: 10px 18px 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 2.05;
    color: var(--night-text-2);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .term-prompt { color: #5B8DFF; }
  .term-typed { color: var(--night-text); }
  .term-caret {
    display: inline-block;
    width: 7px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.9);
    margin-left: 2px;
  }
  .term-out {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.45s ease-out, transform 0.45s ease-out;
  }
  .term-out.show { opacity: 1; transform: none; }
  .term-glyph { margin-right: 6px; }
  .term-add { color: #28C840; }
  .term-del { color: #FF6B6B; }
  .term-dim { color: var(--night-text-3); font-size: 11.5px; }

  .win-status {
    --lg-blur: 18px;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 34px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    font-size: 11.5px;
    color: var(--night-text-2);
    white-space: nowrap;
    overflow: hidden;
  }
  .win-status-live { display: inline-flex; align-items: center; gap: 7px; color: var(--night-text); }
  .win-status-mono { font-family: var(--font-mono); }

  .win-chip-pulse {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    animation: win-pulse 1.6s ease-in-out infinite;
  }
  @keyframes win-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(10, 132, 255, 0.5); }
    50% { opacity: 0.6; box-shadow: 0 0 0 4px rgba(10, 132, 255, 0); }
  }

  /* Soft fade from the night hero into the light page below */
  .hero-fade {
    height: 120px;
    margin-top: -1px;
    background: linear-gradient(180deg, transparent, var(--page));
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .win-chip-pulse { animation: none; }
    .term-out { opacity: 1; transform: none; }
  }
</style>

<script>
  // Platform-aware CTA: the primary button auto-targets the visitor's OS
  // installer, falling back to #download when the platform is unknown.
  const el = document.getElementById('hero-primary-dl');
  if (el) {
    const ua = navigator.userAgent;
    const plat = (navigator.platform || '') + ' ' + ua;
    const isMac = /Mac|iPhone|iPad/i.test(plat);
    const isWin = /Win/i.test(plat);
    const win = el.getAttribute('data-win');
    const mac = el.getAttribute('data-mac');
    if (isMac && mac) {
      el.setAttribute('href', mac);
      el.textContent = 'Download for macOS';
    } else if (isWin && win) {
      el.setAttribute('href', win);
      el.textContent = 'Download for Windows';
    }
  }

  // Terminal vignette: type the task, then reveal the agent's output lines.
  // Plays once, when the mockup scrolls into view.
  const term = document.getElementById('hero-term');
  const typedEl = document.getElementById('term-typed');
  const TASK = 'refactor the session store to derive unread state';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function playTerm() {
    if (!term || term.dataset.played === 'true') return;
    term.dataset.played = 'true';
    const outs = term.querySelectorAll('.term-out');
    if (reduced) {
      if (typedEl) typedEl.textContent = TASK;
      outs.forEach((o) => o.classList.add('show'));
      return;
    }
    let i = 0;
    const type = () => {
      if (!typedEl) return;
      i += 1;
      typedEl.textContent = TASK.slice(0, i);
      if (i < TASK.length) {
        window.setTimeout(type, 26 + Math.random() * 34);
      } else {
        outs.forEach((o, idx) => {
          window.setTimeout(() => o.classList.add('show'), 420 + idx * 520);
        });
      }
    };
    window.setTimeout(type, 500);
  }

  if (term) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          playTerm();
          io.disconnect();
        }
      },
      { threshold: 0.35 }
    );
    io.observe(term);
  }
</script>
