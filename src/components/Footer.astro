---
interface Props { version?: string }
const { version } = Astro.props;

// Build date at build time. Format: "30 Aug 2026"
const buildDate = new Date().toLocaleDateString('en-GB', {
  day: '2-digit', month: 'short', year: 'numeric',
});
---

<footer class="footer night-band">
  <div class="container-wide footer-wrap">
  <div class="footer-inner glass-night">
    <div class="footer-brand">
      <p class="footer-wordmark">
        <img class="footer-mark" src="/icons/mark.png" alt="" width="20" height="20" decoding="async" loading="lazy" />
        <span>Agentrium</span>
      </p>
      <p class="footer-tagline on-night-3">The native desktop home for coding agents.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/#agents">Agents</a>
      <a href="/#features">Features</a>
      <a href="/#download">Download</a>
      <a href="/changelog">Changelog</a>
      <a href="https://github.com/talayash/agentrium" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://github.com/talayash/agentrium/blob/master/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a>
    </nav>

    <p class="footer-meta on-night-3">
      {version && <span>v{version} &middot; </span>}built {buildDate}
    </p>
  </div>
  </div>
</footer>

<style>
  .footer {
    padding: 8px 0 40px;
    background: var(--night-canvas);
  }
  .footer-wrap { position: relative; z-index: 1; }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 22px 28px;
    padding: 26px 30px;
    border-radius: 30px;
  }

  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 6px;
    font-weight: 600;
    font-size: 15px;
    color: var(--night-text);
  }
  .footer-tagline { font-size: 12.5px; margin: 0; }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
  }
  .footer-links a {
    font-size: 13px;
    color: var(--night-text-2);
    text-decoration: none;
    transition: color 150ms ease-out;
  }
  .footer-links a:hover { color: var(--night-text); }

  .footer-meta {
    font-size: 12px;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
