---
// Editorial spread: 1 large left + 2 small stacked right, framed like
// floating windows. Images come from the shipping release.
const screenshots = {
  main: { file: 'grid-view.png', alt: 'Grid view running Claude Code, Codex, Cursor, and Antigravity in parallel', caption: 'Grid view: four agents working in parallel' },
  grid: { file: 'main-view.png', alt: 'Welcome screen with the agent picker on the Midnight canvas', caption: 'Welcome' },
  settings: { file: 'new-terminal.png', alt: 'New Session dialog with agent, profile, and model pickers', caption: 'New Session' },
};
---

<section id="screenshots" class="section screenshots pastel-band">
  <div class="container-wide">
    <p class="kicker tint-light reveal">Screenshots</p>
    <h2 class="h2 screenshots-h2 reveal" style="--d: 60ms">In the wild.</h2>
    <p class="meta screenshots-note reveal" style="--d: 100ms">From the current shipping release.</p>

    <div class="shot-grid">
      <figure class="shot shot-main glass reveal" style="--d: 120ms">
        <img src={`/screenshots/${screenshots.main.file}`} alt={screenshots.main.alt} loading="lazy" decoding="async" />
        <figcaption class="label">{screenshots.main.caption}</figcaption>
      </figure>
      <div class="shot-stack">
        <figure class="shot glass reveal" style="--d: 220ms">
          <img src={`/screenshots/${screenshots.grid.file}`} alt={screenshots.grid.alt} loading="lazy" decoding="async" />
          <figcaption class="label">{screenshots.grid.caption}</figcaption>
        </figure>
        <figure class="shot glass reveal" style="--d: 320ms">
          <img src={`/screenshots/${screenshots.settings.file}`} alt={screenshots.settings.alt} loading="lazy" decoding="async" />
          <figcaption class="label">{screenshots.settings.caption}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .screenshots { background: var(--page); }
  .screenshots .kicker { display: inline-block; padding: 7px 14px; border-radius: var(--radius-pill); margin-bottom: 18px; }

  .screenshots-h2 { margin-bottom: 10px; }
  .screenshots-note { margin-bottom: 48px; }

  .shot-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 22px;
    align-items: start;
  }
  @media (max-width: 767px) {
    .shot-grid { grid-template-columns: 1fr; }
  }

  .shot-stack {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* Each screenshot sits in a glass bezel, like a floating window. */
  .shot {
    margin: 0;
    padding: 8px 8px 12px;
    border-radius: 24px;
  }
  .shot img {
    width: 100%;
    border-radius: 16px;
    border: 1px solid var(--frame);
    box-shadow: 0 2px 10px rgba(10, 14, 30, 0.12);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 300ms ease-out;
  }
  .shot img:hover {
    transform: translateY(-3px) scale(1.006);
    box-shadow: var(--shadow-float-md);
  }
  .shot figcaption { margin: 10px 6px 0; }
</style>
